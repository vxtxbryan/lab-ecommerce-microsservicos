apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: payments-api-credentials
  namespace: default
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: aws-secrets-manager
    kind: SecretStore
  target:
    name: payments-api-credentials
    creationPolicy: Owner
    deletionPolicy: Retain
  data:
    - secretKey: API_KEY
      remoteRef:
        key: ecommerce-microsservicos/payments/provider-api
        property: api_key
